{
  "name": "deepclause-cli-wasm",
  "version": "0.0.1",
  "main": "src/electron/main/index.js",
  "bin": {
    "deepclause": "./src/main.js"
  },
  "scripts": {
    "cli": "node src/main.js",
    "dev:vite": "vite",
    "build:vite": "vite build",
    "electron": "electron .",
    "electron:dev": "NODE_ENV=development electron .",
    "electron:dev:win": "set NODE_ENV=development && electron .",
    "dev": "concurrently \"npm run dev:vite\" \"wait-on http://localhost:5173 && npm run electron:dev\"",
    "build": "npm run build:vite && electron-builder",
    "build:linux": "npm run build:vite && electron-builder --linux",
    "build:mac": "npm run build:vite && electron-builder --mac",
    "build:win": "npm run build:vite && electron-builder --win"
  },
  "type": "module",
  "author": "Andreas Pfadler <andreas.pfadler@gmail.com>",
  "homepage": "https://www.deepclause.ai",
  "license": "ISC",
  "description": "DeepClause - Neurosymbolic AI System with DML",
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.23",
    "@ai-sdk/gateway": "^1.0.30",
    "@ai-sdk/google": "^2.0.15",
    "@ai-sdk/openai": "^2.0.44",
    "@ai-sdk/openai-compatible": "^1.0.27",
    "@modelcontextprotocol/sdk": "^1.18.2",
    "@monaco-editor/react": "^4.7.0",
    "@openrouter/ai-sdk-provider": "^1.2.0",
    "@wasmer/sdk": "^0.10.0",
    "@wasmer/wasi": "^1.2.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "ai": "^5.0.48",
    "dompurify": "^3.3.0",
    "esbuild": "^0.25.10",
    "glob": "^11.0.3",
    "jsdom": "^27.1.0",
    "lucide-react": "^0.344.0",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "mermaid": "^11.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "turndown": "^7.2.2",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "electron": "^39.2.7",
    "electron-builder": "^24.13.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "zod": "^3.25.76"
  },
  "build": {
    "appId": "com.deepclause.app",
    "productName": "DeepClause",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "vendor/**/*",
      "node_modules/**/*",
      "package.json",
      "dist/renderer/**/*"
    ],
    "asarUnpack": [
      "vendor/v86/build/**/*",
      "vendor/swipl-wasm/dist/**/*",
      "src/electron/initial_examples/**/*",
      "src/electron/initial_workspace/**/*"
    ],
    "extraResources": [
      {
        "from": "dml_examples",
        "to": "dml_examples"
      },
      {
        "from": "config",
        "to": "config"
      },
      {
        "from": "src/electron/initial_workspace",
        "to": "initial_workspace"
      },
      {
        "from": "vendor/v86/images",
        "to": "vendor/v86/images"
      },
      {
        "from": "vendor/v86/bios",
        "to": "vendor/v86/bios"
      },
      {
        "from": "vendor/v86/build",
        "to": "vendor/v86/build"
      },
      {
        "from": "src/dml-core",
        "to": "src/dml-core"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": "nsis"
    }
  }
}
