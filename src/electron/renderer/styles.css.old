* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    /* Sophisticated Black & White Color Scheme */
    --primary-color: #1A1A1A;        /* Deep black */
    --dc-primary: #1A1A1A;
    --dc-primary-dark: #000000;
    --dc-primary-glow: rgba(0, 0, 0, 0.15);
    --secondary-color: #4A4A4A;
    --dc-secondary: #4A4A4A;
    --danger-color: #DC3545;
    --dc-danger: #DC3545;
    --success-color: #28A745;
    --dc-success: #28A745;
    
    /* Light theme backgrounds */
    --bg-darkest: #FFFFFF;           /* Pure white */
    --bg-dark: #F.status-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 1.5rem;
    background: var(--bg-medium);
    border-top: 1px solid var(--border-color);
    font-size: 0.8rem;
    color: var(--text-secondary);
}          /* Off white */
    --bg-medium: #F5F5F5;            /* Light grey */
    --bg-light: #E8E8E8;             /* Medium grey */
    --hover-color: #DDDDDD;          /* Darker grey for hover */
    
    /* Text colors */
    --text-primary: #1A1A1A;         /* Deep black */
    --text-secondary: #666666;       /* Medium grey */
    --text-dim: #999999;             /* Light grey */
    
    /* Border colors */
    --border-color: #DDDDDD;
    --border-accent: var(--dc-primary);
    
    /* Shadows */
    --shadow-glow: 0 0 15px rgba(0, 0, 0, 0.08);
    --shadow-soft: 0 2px 8px rgba(0, 0, 0, 0.08);
    --shadow-medium: 0 4px 12px rgba(0, 0, 0, 0.1);
}

body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    background: var(--bg-darkest);
    color: var(--text-primary);
    height: 100vh;
    overflow: hidden;
    line-height: 1.6;
}

.container {
    display: flex;
    flex-direction: column;
    height: 100vh;
    background: var(--bg-darkest);
}

/* Header */
.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    background: var(--bg-darkest);
    border-bottom: 2px solid var(--dc-primary);
    box-shadow: var(--shadow-soft);
    position: relative;
}

.logo-section {
    display: flex;
    align-items: center;
    gap: 1rem;
}

.logo-icon {
    height: 48px;
    width: 48px;
    object-fit: contain;
    filter: grayscale(100%) contrast(1.2);
}

.logo-text {
    display: flex;
    flex-direction: column;
}

.app-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--dc-primary);
    letter-spacing: -0.5px;
}

.app-subtitle {
    font-size: 0.7rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 500;
}

.header-actions {
    display: flex;
    gap: 0.5rem;
}

/* Buttons */
.btn {
    padding: 0.5rem 1rem;
    border: none;
    border-radius: 4px;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.2s;
    font-weight: 500;
}

.btn-primary {
    background: var(--dc-primary);
    color: var(--bg-darkest);
    font-weight: 600;
    box-shadow: var(--shadow-soft);
}

.btn-primary:hover:not(:disabled) {
    background: var(--dc-primary-dark);
    box-shadow: var(--shadow-medium);
    transform: translateY(-1px);
}

.btn-secondary {
    background-color: var(--bg-light);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
}

.btn-secondary:hover {
    background-color: var(--hover-color);
    border-color: var(--dc-primary);
}

.btn-danger {
    background: var(--dc-danger);
    color: white;
    box-shadow: var(--shadow-soft);
}

.btn-danger:hover {
    background: #C82333;
    box-shadow: var(--shadow-medium);
    transform: translateY(-1px);
}

.btn-icon-toggle {
    background: var(--bg-darkest);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
    padding: 0.6rem 1rem;
}

.btn-icon-toggle:hover {
    background: var(--bg-medium);
    border-color: var(--dc-primary);
}

.btn-icon-toggle.active {
    background: var(--dc-primary);
    border-color: var(--dc-primary);
    color: var(--bg-darkest);
    font-weight: 600;
}

.btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

.btn-icon {
    background: none;
    border: none;
    font-size: 1.2rem;
    cursor: pointer;
    padding: 0.25rem;
    color: var(--text-secondary);
    transition: color 0.2s;
}

.btn-icon:hover {
    color: var(--text-primary);
}

/* Main content */
.main-content {
    display: flex;
    flex: 1;
    overflow: hidden;
}

/* Sidebar */
.sidebar {
    width: 300px;
    background: var(--bg-medium);
    border-right: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, width 0.3s ease;
    position: relative;
}

.sidebar-right {
    border-right: none;
    border-left: 1px solid var(--border-color);
}

.sidebar.hidden {
    transform: translateX(-100%);
    width: 0;
    min-width: 0;
}

.sidebar-right.hidden {
    transform: translateX(100%);
}

.sidebar-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
    border-bottom: 2px solid var(--dc-primary);
    background: var(--bg-darkest);
}

.sidebar-header h3 {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 1.5px;
}

.sidebar-actions {
    display: flex;
    gap: 0.25rem;
}

.file-list, .workspace-list {
    flex: 1;
    overflow-y: auto;
    padding: 0.75rem;
}

.file-item, .workspace-item {
    padding: 0.75rem;
    margin-bottom: 0.5rem;
    background: var(--bg-darkest);
    border: 1px solid var(--border-color);
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s ease;
    position: relative;
}

.file-item::before, .workspace-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--dc-primary);
    opacity: 0;
    transition: opacity 0.2s;
    border-radius: 4px 0 0 4px;
}

.file-item:hover, .workspace-item:hover {
    background: var(--bg-light);
    border-color: var(--dc-primary);
    box-shadow: var(--shadow-soft);
    transform: translateX(2px);
}

.file-item:hover::before, .workspace-item:hover::before {
    opacity: 1;
}

.file-name, .workspace-item-name {
    font-weight: 600;
    font-size: 0.9rem;
    margin-bottom: 0.25rem;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.file-icon, .workspace-icon {
    font-size: 1.1rem;
}

.file-description {
    font-size: 0.75rem;
    color: var(--text-secondary);
    margin-bottom: 0.25rem;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
}

.file-parameters {
    font-size: 0.7rem;
    color: var(--primary-color);
    font-family: 'Courier New', monospace;
}

.loading, .empty, .error {
    text-align: center;
    padding: 2rem;
    color: var(--text-secondary);
    font-size: 0.9rem;
}

.error {
    color: var(--danger-color);
}

/* Chat container */
.chat-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    background-color: var(--bg-dark);
}

.chat-output {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem;
}

.welcome-message {
    max-width: 800px;
    margin: 2rem auto;
    animation: fadeInUp 0.6s ease-out;
}

.welcome-header {
    text-align: center;
    margin-bottom: 2rem;
}

.welcome-logo {
    max-width: 300px;
    height: auto;
    margin-bottom: 1rem;
    filter: grayscale(100%) contrast(1.2);
}

.welcome-message h2 {
    font-size: 2.2rem;
    margin-bottom: 0.5rem;
    color: var(--dc-primary);
    font-weight: 700;
}

.welcome-tagline {
    color: var(--text-secondary);
    margin-bottom: 2rem;
    font-size: 1.1rem;
    text-align: center;
}

.quick-tips {
    background: var(--bg-medium);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 2rem;
    box-shadow: var(--shadow-soft);
    position: relative;
    overflow: hidden;
}

.quick-tips::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--dc-primary);
}

.quick-tips h3 {
    font-size: 1.2rem;
    margin-bottom: 1.5rem;
    color: var(--dc-primary);
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.quick-tips ul {
    list-style: none;
    padding-left: 0;
}

.quick-tips li {
    margin-bottom: 1rem;
    padding-left: 1.75rem;
    position: relative;
    line-height: 1.6;
}

.quick-tips li:before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--dc-primary);
    font-weight: bold;
    font-size: 1.2rem;
}

.quick-tips code {
    background: var(--bg-light);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-family: 'JetBrains Mono', 'Courier New', monospace;
    font-size: 0.85em;
    color: var(--dc-primary);
    border: 1px solid var(--border-color);
}

/* Messages */
.message {
    margin-bottom: 1.5rem;
    padding: 1rem;
    border-radius: 8px;
    position: relative;
    max-width: 800px;
}

.message-user {
    background: var(--dc-primary);
    color: var(--bg-darkest);
    margin-left: auto;
    margin-right: 0;
    border: 1px solid var(--dc-primary);
}

.message-agent {
    background: var(--bg-medium);
    border: 1px solid var(--border-color);
    box-shadow: var(--shadow-soft);
}

.message-streaming {
    background: var(--bg-medium);
    border: 2px solid var(--dc-primary);
    position: relative;
}

.message-streaming::after {
    content: '●';
    position: absolute;
    top: 1rem;
    right: 1rem;
    color: var(--primary-color);
    font-size: 1.5rem;
    animation: pulse 1.5s ease-in-out infinite;
}

@keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
}

.streaming-content {
    font-family: 'Courier New', monospace;
    white-space: pre-wrap;
    word-wrap: break-word;
    color: var(--text-primary);
}

.message-system {
    background-color: var(--bg-light);
    border-left: 3px solid var(--primary-color);
}

.message-error {
    background-color: rgba(220, 53, 69, 0.1);
    border-left: 3px solid var(--danger-color);
}

.timestamp {
    font-size: 0.7rem;
    color: var(--text-secondary);
    display: block;
    margin-bottom: 0.5rem;
}

.message-user .timestamp {
    color: rgba(255, 255, 255, 0.7);
}

.message-content {
    line-height: 1.6;
    white-space: pre-wrap;
    word-wrap: break-word;
}

.message-content code {
    background-color: var(--bg-light);
    padding: 0.2rem 0.4rem;
    border-radius: 3px;
    font-family: 'Courier New', monospace;
    font-size: 0.9em;
}

.message-user .message-content code {
    background-color: rgba(0, 0, 0, 0.2);
}

.message-content strong {
    font-weight: 600;
    color: var(--primary-color);
}

/* Input container */
.input-container {
    display: flex;
    gap: 0.5rem;
    padding: 1rem 1.5rem;
    background-color: var(--bg-medium);
    border-top: 1px solid var(--border-color);
}

.user-input {
    flex: 1;
    background-color: var(--bg-light);
    border: 1px solid var(--border-color);
    border-radius: 4px;
    padding: 0.75rem;
    color: var(--text-primary);
    font-size: 0.95rem;
    font-family: inherit;
    resize: none;
    min-height: 60px;
    max-height: 200px;
    overflow-y: auto;
}

.user-input:focus {
    outline: none;
    border-color: var(--primary-color);
}

.user-input::placeholder {
    color: var(--text-secondary);
}

/* Status bar */
.status-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 1.5rem;
    background-color: var(--bg-medium);
    border-top: 1px solid var(--border-color);
    font-size: 0.8rem;
    color: var(--text-secondary);
}

.path-info {
    font-family: 'Courier New', monospace;
    font-size: 0.75rem;
}

/* Scrollbar styling */
::-webkit-scrollbar {
    width: 10px;
    height: 10px;
}

::-webkit-scrollbar-track {
    background: var(--bg-medium);
}

::-webkit-scrollbar-thumb {
    background: var(--border-color);
    border-radius: 5px;
    border: 2px solid var(--bg-medium);
}

::-webkit-scrollbar-thumb:hover {
    background: var(--text-secondary);
}

/* Modal overlay for input dialogs */
.modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.7);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1000;
    animation: fadeIn 0.2s ease-out;
}

.modal-content {
    background-color: var(--bg-medium);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 2rem;
    min-width: 400px;
    max-width: 600px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
}

.modal-content h3 {
    color: var(--primary-color);
    margin-bottom: 1rem;
    font-size: 1.3rem;
}

.modal-prompt {
    color: var(--text-primary);
    margin-bottom: 1.5rem;
    line-height: 1.6;
}

.modal-input {
    width: 100%;
    background-color: var(--bg-light);
    border: 1px solid var(--border-color);
    border-radius: 4px;
    padding: 0.75rem;
    color: var(--text-primary);
    font-size: 1rem;
    font-family: inherit;
    margin-bottom: 1.5rem;
}

.modal-input:focus {
    outline: none;
    border-color: var(--dc-primary);
    box-shadow: 0 0 0 2px rgba(26, 26, 26, 0.1);
}

.modal-buttons {
    display: flex;
    gap: 0.75rem;
    justify-content: flex-end;
}

.modal-buttons .btn {
    min-width: 100px;
}

/* Animations */
@keyframes fadeIn {
    from {
        opacity: 0;
    }
    to {
        opacity: 1;
    }
}

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes pulse {
    0%, 100% { 
        opacity: 1;
        transform: scale(1);
    }
    50% { 
        opacity: 0.4;
        transform: scale(0.8);
    }
}

.message {
    animation: fadeInUp 0.3s ease-out;
}
